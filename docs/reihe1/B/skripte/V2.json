              "fehlbild": "qf_streckfaktor_umgekehrt",
              "ruecksprung": "b5",
              "rueckmeldung": "Ein a zwischen 0 und 1 macht die Parabel weiter, nicht enger."
            },
            {
              "antwort": "y = x² + 4",
              "fehlbild": "qf_oeffnung_aus_e",
              "ruecksprung": "b4",
              "rueckmeldung": "Die Zahl hinten verschiebt nur nach oben. Die Form bestimmt a."
            }
          ]
        }
      ]
    },
    {
      "nach_beat": "b6",
      "frage": {
        "skelett": "Wie sieht y = −2x² im Vergleich zur Normalparabel aus?"
      },
      "optionen": [
        {
          "antwort": "nach unten, enger",
          "richtig": true,
          "rueckmeldung": "Genau. Minus heißt unten, 2 heißt enger."
        },
