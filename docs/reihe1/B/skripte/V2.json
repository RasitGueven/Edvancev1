        },
        {
          "antwort": "nach unten, weiter",
          "fehlbild": "qf_streckfaktor_umgekehrt",
          "ruecksprung": "b3",
          "rueckmeldung": "Der Betrag 2 ist größer als 1, das macht sie enger."
        }
      ],
      "zwillinge": [
        {
