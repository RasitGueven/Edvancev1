        {
          "antwort": "(x + 4)² + 10",
          "fehlbild": "qf_ergaenzung_nicht_abgezogen",
          "ruecksprung": "b5",
          "rueckmeldung": "Die 16 hast du dazugegeben. Du musst sie auch wieder abziehen."
        },
        {
          "antwort": "(x + 8)² − 54",
          "fehlbild": "qf_ergaenzung_b_statt_halb",
          "ruecksprung": "b3",
          "rueckmeldung": "In die Klammer kommt die Hälfte von 8, also 4."
        }
      ],
      "zwillinge": [
        {
          "frage": {
