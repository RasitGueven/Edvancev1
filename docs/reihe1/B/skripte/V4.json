          },
          "optionen": [
            {
              "antwort": "2(x + 3)² − 13",
              "richtig": true,
              "rueckmeldung": "Genau. 2 · ((x + 3)² − 9) + 5."
            },
            {
              "antwort": "2(x + 3)² − 4",
