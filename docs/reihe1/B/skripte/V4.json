              "richtig": true,
              "rueckmeldung": "Genau. x² + 6x + 9 − 9 + 2 = (x + 3)² − 7."
            },
            {
              "antwort": "(x + 3)² + 2",
              "fehlbild": "qf_ergaenzung_nicht_abgezogen",
              "ruecksprung": "b5",
              "rueckmeldung": "Die 9 hast du dazugegeben. Du musst sie auch wieder abziehen."
            },
            {
              "antwort": "(x + 6)² − 34",
              "fehlbild": "qf_ergaenzung_b_statt_halb",
              "ruecksprung": "b3",
              "rueckmeldung": "In die Klammer kommt die Hälfte von 6, also 3."
            }
          ]
        }
      ]
    },
    {
      "nach_beat": "b8",
      "frage": {
        "skelett": "Bring 3x² + 6x + 1 in die Scheitelpunktform."
      },
      "optionen": [
        {
          "antwort": "3(x + 1)² − 2",
          "richtig": true,
          "rueckmeldung": "Genau. 3 · ((x + 1)² − 1) + 1."
        },
        {
          "antwort": "3(x + 1)²",
          "fehlbild": "qf_ergaenzung_ohne_a",
          "ruecksprung": "b8",
          "rueckmeldung": "Die abgezogene 1 steht in der Klammer mit dem Faktor 3: −3, nicht −1."
        },
        {
          "antwort": "3(x + 1)² + 1",
